# ==================== 运行环境 ====================

COMPOSE_PROJECT_NAME=school-uniform-prod
APP_ENV=prod

# 必须替换为足够长的随机字符串，例如：
#   openssl rand -hex 64
APP_KEYS=REPLACE_WITH_A_RANDOM_128_CHARACTER_SECRET
API_WORKERS=1

# Nginx 暴露到服务器的 HTTP 端口。
WEB_PORT=80

# 正式环境使用独立镜像标签，不与测试环境共用 latest。
API_IMAGE=ghcr.io/ccc-chan/school-uniform-platform-api:prod-latest
WEB_IMAGE=ghcr.io/ccc-chan/school-uniform-platform-web:prod-latest

# ==================== MySQL ====================

# 生产容器通过 Docker 内部服务名访问，不对公网开放数据库端口。
DB_HOST=mysql
DB_PORT=3306
DB_NAME=school_uniform
DB_USER=school_uniform
DB_PASSWORD=REPLACE_WITH_A_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_ROOT_PASSWORD

# ==================== Redis ====================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_REDIS_PASSWORD

# ==================== MinIO 对象存储 ====================

STORAGE_DRIVER=minio
STORAGE_ENDPOINT=minio
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_BUCKET=school-uniform-prod
STORAGE_ACCESS_KEY=school_uniform_storage
STORAGE_SECRET_KEY=REPLACE_WITH_A_STRONG_MINIO_PASSWORD

# 当前使用同一组凭据初始化 MinIO；后续可再拆分最小权限账号。
MINIO_ROOT_USER=school_uniform_storage
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_MINIO_PASSWORD

# ==================== Web 前端 ====================

# 正式环境必须使用 HTTPS 域名，禁止开启测试环境的 HTTP 放行。
VITE_QR_PUBLIC_BASE_URL=https://example.com
VITE_QR_ALLOW_HTTP_IN_TEST=false
