{
  "name": "school-uniform-digital-identity-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace=@school-uniform/admin-web",
    "dev:api": "npm run dev --workspace=@school-uniform/api",
    "dev:test:web": "npm run dev:test --workspace=@school-uniform/admin-web",
    "dev:test:api": "npm run dev:test --workspace=@school-uniform/api",
    "build": "npm run build --workspace=@school-uniform/admin-web",
    "build:test": "npm run build:test --workspace=@school-uniform/admin-web",
    "typecheck": "npm run typecheck --workspace=@school-uniform/admin-web",
    "check:api": "npm run check --workspace=@school-uniform/api"
  }
}
