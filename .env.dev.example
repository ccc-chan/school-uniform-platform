# ==================== 运行环境 ====================

# Compose 项目名用于隔离容器、网络和数据卷。
COMPOSE_PROJECT_NAME=school-uniform-dev

# API 根据该值加载仓库根目录的 .env.dev。
APP_ENV=dev

# Egg 数据签名密钥。本地开发也应避免使用生产密钥。
APP_KEYS=school_uniform_dev_signing_key_change_if_shared

# API 工作进程数；本地开发使用 1 个即可。
API_WORKERS=1

# ==================== MySQL ====================

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=school_uniform
DB_USER=school_uniform
DB_PASSWORD=school_uniform_dev

# 仅供 MySQL 容器初始化使用。
MYSQL_ROOT_PASSWORD=school_uniform_root_dev

# ==================== Redis ====================

# Redis 保存登录会话、验证码、权限缓存和限流计数。
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=school_uniform_redis_dev

# ==================== MinIO 对象存储 ====================

STORAGE_DRIVER=minio
STORAGE_ENDPOINT=127.0.0.1
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_BUCKET=school-uniform-dev
STORAGE_ACCESS_KEY=school_uniform
STORAGE_SECRET_KEY=school_uniform_minio_dev

# MinIO 暴露到本机的 API 与管理控制台端口。
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=school_uniform
MINIO_ROOT_PASSWORD=school_uniform_minio_dev

# ==================== Web 前端 ====================

# 本地 Vite 开发服务器把 /api 请求代理到已部署的服务器。
# 该配置不会开放服务器的 MySQL、Redis 或 MinIO。
API_PROXY_TARGET=http://111.228.47.54:18080

# 二维码指向服务器上可被手机访问的公开页面。
# 只有 VITE_ 开头的变量会进入浏览器代码，禁止在此类变量中填写密码。
VITE_QR_PUBLIC_BASE_URL=http://111.228.47.54:18080
