# ==================== 运行环境 ====================

# 测试服务器使用独立容器、网络和数据卷。
COMPOSE_PROJECT_NAME=school-uniform-test
APP_ENV=test

# 必须替换为随机密钥，例如：openssl rand -hex 64
APP_KEYS=REPLACE_WITH_A_RANDOM_128_CHARACTER_TEST_SECRET
API_WORKERS=1

# Nginx 暴露到服务器的 HTTP 端口。
WEB_PORT=18080

# CI/CD 发布的测试镜像；commit SHA 标签可用于回滚。
API_IMAGE=ghcr.io/ccc-chan/school-uniform-platform-api:test-latest
WEB_IMAGE=ghcr.io/ccc-chan/school-uniform-platform-web:test-latest

# ==================== MySQL ====================

# 数据库只允许 Docker 内部访问，不开放公网端口。
DB_HOST=mysql
DB_PORT=3306
DB_NAME=school_uniform_test
DB_USER=school_uniform_test
DB_PASSWORD=REPLACE_WITH_A_STRONG_TEST_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_A_DIFFERENT_TEST_ROOT_PASSWORD

# ==================== Redis ====================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=1
REDIS_PASSWORD=REPLACE_WITH_A_STRONG_TEST_REDIS_PASSWORD

# ==================== MinIO 对象存储 ====================

STORAGE_DRIVER=minio
STORAGE_ENDPOINT=minio
STORAGE_PORT=9000
STORAGE_USE_SSL=false
STORAGE_BUCKET=school-uniform-test
STORAGE_ACCESS_KEY=school_uniform_test_storage
STORAGE_SECRET_KEY=REPLACE_WITH_A_STRONG_TEST_MINIO_PASSWORD

MINIO_ROOT_USER=school_uniform_test_storage
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_STRONG_TEST_MINIO_PASSWORD

# ==================== Web 前端 ====================

# 本地测试前端的 /api 请求也代理到该测试服务器。
API_PROXY_TARGET=http://111.228.47.54:18080

# 测试二维码指向该服务器的公开页面。
VITE_QR_PUBLIC_BASE_URL=http://111.228.47.54:18080
